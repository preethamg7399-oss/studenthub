# StudentHub Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=studenthub_super_secret_dev_key_2026_change_in_production

# Database Configuration
# Local SQLite (default)
DATABASE_URL=sqlite:///studenthub.db
# For PostgreSQL migration, uncomment and configure below:
# DATABASE_URL=postgresql://username:password@localhost:5432/studenthub_db

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=app/static/uploads
